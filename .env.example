DATABASE_URL=postgresql+asyncpg://kaiserclaim:secret@localhost:5432/kaiserclaim
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

GEMINI_API_KEY=your-gemini-api-key-here

STORAGE_ROOT=/mnt/nas/kaiserclaim

SECRET_KEY=change-me-in-production
DEBUG=false

# Portal credentials (used by Playwright bots)
MERKUR_USERNAME=your@email.at
MERKUR_PASSWORD=your-merkur-password

# Shared secret required in the X-Webhook-Secret header on /webhooks/* routes
WEBHOOK_SECRET=change-me-generate-a-random-value

# Static bearer token for /api/v1 (generate: openssl rand -hex 32). Empty rejects all requests.
API_TOKEN=CHANGE_ME

# Home Assistant notify service for failure / reminder pushes (Signal).
# All three must be set to real values or notifications are dropped.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=CHANGE_ME
HA_NOTIFY_SERVICE=CHANGE_ME
